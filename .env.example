# Metric store (histórico de métricas coletadas)
OBSDADOS_METRIC_STORE_PATH=metricas.duckdb

# Backend padrão usado pela CLI quando --backend não é informado
OBSDADOS_BACKEND_PADRAO=duckdb

# DuckDB (backend de origem)
OBSDADOS_DUCKDB_DB_ORIGEM=

# PostgreSQL — valores abaixo batem com o docker-compose.yml deste projeto
OBSDADOS_POSTGRES_HOST=localhost
OBSDADOS_POSTGRES_PORTA=5433
OBSDADOS_POSTGRES_BANCO=obsdados_teste
OBSDADOS_POSTGRES_USUARIO=obsdados
OBSDADOS_POSTGRES_SENHA=obsdados_dev

# SQL Server (fase futura — placeholder, ainda não usado)
OBSDADOS_SQLSERVER_HOST=
OBSDADOS_SQLSERVER_PORTA=1433
OBSDADOS_SQLSERVER_BANCO=
OBSDADOS_SQLSERVER_USUARIO=
OBSDADOS_SQLSERVER_SENHA=
